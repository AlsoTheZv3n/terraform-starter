# Default: auto-detect text, normalize to LF in repo, checkout per-OS setting.
* text=auto eol=lf

# Scripts / configs must be LF even on Windows checkout (executed on Linux hosts).
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.tf      text eol=lf
*.tfvars  text eol=lf
*.hcl     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
Makefile  text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf

# Windows-native files (keep CRLF if any ever appear).
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary — never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.tar     binary
*.tar.gz  binary
*.tgz     binary
*.gz      binary
*.jar     binary
